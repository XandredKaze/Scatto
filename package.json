{
  "name": "scatto",
  "version": "0.1.0",
  "description": "Ponte tra Elgato Wave Link e OBS Studio: mix per scena, indicatore mic, sync livelli e azioni su eventi.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "scatto": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "list": "tsx src/index.ts list",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "obs-websocket-js": "^5.0.6",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
